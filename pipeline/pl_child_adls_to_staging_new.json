{
	"name": "pl_child_adls_to_staging_new",
	"properties": {
		"activities": [
			{
				"name": "copy_ADLSToStaging",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "script_LogStagingStart",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": {
							"value": "@if(equals(pipeline().parameters.LoadType, 'FULL'),\n    concat('TRUNCATE TABLE ', pipeline().parameters.TargetSchema, '.', pipeline().parameters.TargetStagingTable),\n    concat('DELETE FROM ', pipeline().parameters.TargetSchema, '.', pipeline().parameters.TargetStagingTable, ' WHERE ', pipeline().parameters.WatermarkColumn, ' > ', pipeline().parameters.LastProcessedWatermark)\n)",
							"type": "Expression"
						},
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"tableOption": "autoCreate",
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_ADLS_Generic_Source",
						"type": "DatasetReference",
						"parameters": {
							"p_FolderPath": "@pipeline().parameters.FolderPath",
							"p_FileName": "@pipeline().parameters.FileName"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_SQL_Staging_Sink",
						"type": "DatasetReference",
						"parameters": {
							"p_TargetSchema": "@pipeline().parameters.TargetSchema",
							"p_TargetTable": "@pipeline().parameters.TargetStagingTable"
						}
					}
				]
			},
			{
				"name": "script_LogStagingStart",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_ADF_Framework_DB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "INSERT INTO dbo.ProcessLog (ProcessId, PipelineRunId, ProcessStep, ProcessStatus, ProcessRunStart, CreatedDate)\nVALUES (@{pipeline().parameters.ProcessId}, '@{pipeline().RunId}', 'Staging Load – Started', 'In-Progress', GETDATE(), GETDATE());",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "script_LogStagingSuccess",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "copy_ADLSToStaging",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_ADF_Framework_DB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "INSERT INTO dbo.ProcessLog (ProcessId, PipelineRunId, ProcessStep, ProcessStatus, RecordCountProcessed, ProcessRunStart, CreatedDate)\nVALUES (\n    @{pipeline().parameters.ProcessId}, \n    '@{pipeline().RunId}', \n    'Staging Load – Success', \n    'Success', \n    @{activity('copy_ADLSToStaging').output.rowsCopied}, \n    GETDATE(), \n    GETDATE()\n);",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "script_LogStagingFailed",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "copy_ADLSToStaging",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_ADF_Framework_DB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "INSERT INTO dbo.ProcessLog (ProcessId, PipelineRunId, ProcessStep, ProcessStatus, ErrorMessage, ProcessRunStart, CreatedDate)\nVALUES (@{pipeline().parameters.ProcessId}, '@{pipeline().RunId}', 'Staging Load – Failed', 'Failed', 'ADLS to Staging copy failed.', GETDATE(), GETDATE());",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "script_ValidateAndGetWatermark",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "script_LogStagingSuccess",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_ADF_Framework_DB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "DECLARE @StagingCount INT;\nDECLARE @MaxWatermark VARCHAR(50);\nDECLARE @SQL NVARCHAR(MAX);\n\nSET @SQL = N'SELECT @cnt = COUNT(*), @maxW = CAST(MAX(' + QUOTENAME('@{pipeline().parameters.WatermarkColumn}') + ') AS VARCHAR(50)) FROM ' + QUOTENAME('@{pipeline().parameters.TargetSchema}') + '.' + QUOTENAME('@{pipeline().parameters.TargetStagingTable}');\n\nEXEC sp_executesql \n    @SQL, \n    N'@cnt INT OUTPUT, @maxW VARCHAR(50) OUTPUT', \n    @cnt = @StagingCount OUTPUT, \n    @maxW = @MaxWatermark OUTPUT;\n\nSELECT \n    ISNULL(@StagingCount, 0) AS StagingRecordCount,\n    ISNULL(@MaxWatermark, '0') AS NewWatermarkValue;",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "script_UpdateWatermarkAndLog",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "script_ValidateAndGetWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_ADF_Framework_DB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "DECLARE @CopiedRows INT = @{activity('copy_ADLSToStaging').output.rowsCopied};\nDECLARE @StagedRows INT = @{activity('script_ValidateAndGetWatermark').output.resultSets[0].rows[0].StagingRecordCount};\n\nIF (@CopiedRows = @StagedRows OR @StagedRows > 0)\nBEGIN\n    -- Update Watermark (Cast as VARCHAR to handle numeric/string key watermarks safely)\n    UPDATE dbo.FrameworkMetadata\n    SET NewWatermark = GETDATE()\n    WHERE ProcessId = @{pipeline().parameters.ProcessId};\n\n    -- Audit Log\n    INSERT INTO dbo.ProcessLog (ProcessId, PipelineRunId, ProcessStep, ProcessStatus, RecordCountProcessed, ProcessRunStart, CreatedDate)\n    VALUES (\n        @{pipeline().parameters.ProcessId}, \n        '@{pipeline().RunId}', \n        'Validation & SCD Type 1 Completed', \n        'Success', \n        @StagedRows, \n        GETDATE(), \n        GETDATE()\n    );\nEND\nELSE\nBEGIN\n    RAISERROR('Record validation failed between ADLS source extraction and SQL Staging sink loading.', 16, 1);\nEND",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "sp_RunSCDType1",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "script_UpdateWatermarkAndLog",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_ExecuteSCDByMetadata]",
					"storedProcedureParameters": {
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"ProcessId": {
							"value": {
								"value": "@pipeline().parameters.ProcessId",
								"type": "Expression"
							},
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_ADF_Framework_DB",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "sp_RunFactProcessing",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "sp_RunSCDType1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_ExecuteFactSales]",
					"storedProcedureParameters": {
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"ProcessId": {
							"value": "2",
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_ADF_Framework_DB",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "sp_LogPipelineFailure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "sp_RunFactProcessing",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "sp_RunSCDType1",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "copy_ADLSToStaging",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_WriteProcessLog]",
					"storedProcedureParameters": {
						"ErrorMessage": {
							"value": "Pipeline step execution failed. Watermark unchanged.",
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"ProcessId": {
							"value": {
								"value": "@pipeline().parameters.ProcessId",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"ProcessRunStart": {
							"value": {
								"value": "@pipeline().TriggerTime",
								"type": "Expression"
							},
							"type": "DateTime"
						},
						"ProcessStatus": {
							"value": "Failed",
							"type": "String"
						},
						"ProcessStep": {
							"value": "Pipeline Failed",
							"type": "String"
						},
						"RecordCountProcessed": {
							"value": "0",
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_ADF_Framework_DB",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"ProcessId": {
				"type": "int"
			},
			"FolderPath": {
				"type": "string"
			},
			"FileName": {
				"type": "string"
			},
			"TargetSchema": {
				"type": "string"
			},
			"TargetStagingTable": {
				"type": "string"
			},
			"LoadType": {
				"type": "string"
			},
			"WatermarkColumn": {
				"type": "string"
			},
			"LastProcessedWatermark": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-12T20:38:46Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}